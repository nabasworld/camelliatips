{
  "manifest_version": 3,
  "name": "Camellia Tips — Luxury Sommelier & Steeping Matrix",
  "version": "1.0.0",
  "description": "Precision steeping timer, rare tea catalog, sommelier pairing guide, and private cellar access for Camellia Tips connoisseurs.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Camellia Tips Sommelier Companion"
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "permissions": [
    "alarms",
    "notifications",
    "storage",
    "contextMenus",
    "activeTab"
  ],
  "host_permissions": [
    "http://localhost:4321/*",
    "http://127.0.0.1:4321/*"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ]
}
